{
    "name": "mrpunyapal/nativephp-plugin-turnstile",
    "description": "Cloudflare Turnstile integration for Laravel and NativePHP Mobile.",
    "type": "library",
    "license": "MIT",
    "keywords": ["cloudflare", "laravel", "nativephp", "turnstile"],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0|^8.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0|^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MrPunyapal\\Turnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrPunyapal\\Turnstile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["MrPunyapal\\Turnstile\\TurnstileServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "composer validate --strict && pint --test && phpstan analyse && rector process --dry-run",
        "format": "pint",
        "analyse": "phpstan analyse",
        "rector": "rector process",
        "rector:test": "rector process --dry-run"
    },
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true},
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
